# Managed by dashboard install.sh. Rendered from deploy/caddy/Caddyfile.tmpl; edits are overwritten.
# Dollar-brace placeholders (TS_HOSTNAME, TS_BIND_ADDR, DASH_PORT) are substituted by
# install.sh; Caddy's own {placeholders} are left untouched.
{
	# No admin endpoint at all. Consequence: use `systemctl restart caddy`, not reload.
	admin off
	# The only listener is HTTPS on the Tailscale address; no port-80 redirect server.
	auto_https disable_redirects
}

# Reverse proxy to the app with the client address passed on exactly once. The app trusts the
# LAST X-Forwarded-For entry and only from loopback, so any client-supplied value is replaced.
(app_proxy) {
	reverse_proxy 127.0.0.1:${DASH_PORT} {
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
	}
}

${TS_HOSTNAME} {
	# Listen on the Tailscale interface address only.
	bind ${TS_BIND_ADDR}

	# Certificate from the local tailscaled (needs TS_PERMIT_CERT_UID=caddy in
	# /etc/default/tailscaled, set by install.sh).
	tls {
		get_certificate tailscale
	}

	# Compress everything except the event stream, which must flush each event.
	@compressible not path /api/stream
	encode @compressible zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# CalDAV/CardDAV discovery.
	redir /.well-known/caldav /dav/ permanent

	# Server-sent events: never buffer.
	@stream path /api/stream
	handle @stream {
		reverse_proxy 127.0.0.1:${DASH_PORT} {
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
		}
	}

	# Launcher apps under /apps/<name>/*, generated by the launcher (plan 08). Empty at install.
	import /etc/caddy/dashboard-apps/*.caddy

	handle {
		import app_proxy
	}

	# Plain page when the app is down; other errors keep Caddy's default response.
	# ({http.error.status_code} works on Caddy 2.6 (Debian) and later.)
	handle_errors {
		@down expression {http.error.status_code} in [502, 503, 504]
		handle @down {
			header Content-Type "text/plain; charset=utf-8"
			respond "Dashboard unavailable (502). The service is not running; check: systemctl status dashboard" 502
		}
	}
}
